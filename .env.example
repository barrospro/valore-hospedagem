# ------------------------------------------------------------------
# Valore — configuração (copie para .env e preencha os valores reais)
#
#   Desenvolvimento: NODE_ENV=development -> PIX local permitido
#   Produção:        NODE_ENV=production  -> PIX local bloqueado por padrão
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# URL pública (usada para montar o postback_url do PIX). Sem barra no fim.
PUBLIC_BASE_URL=http://127.0.0.1:3000

BRAND_NAME=Valore
BRAND_LEGAL_NAME=Valore Correspondente Bancário Ltda
BRAND_CNPJ=00.000.000/0001-00
BRAND_WHATSAPP=5500000000000


ACTIVE_GATEWAY_ID=nitropay
GATEWAY_FEE_FIXED=1.3
GATEWAY_FEE_PERCENT=5.99

# Chave usada só no PIX local de teste (quando ALLOW_MOCK_PIX=1).
PIX_KEY=pix@valore.local

# ---------------------------------------------------------------
# Quantum Pay (Gateway Principal)
# ---------------------------------------------------------------
ACTIVE_GATEWAY_ID=quantumpay
QUANTUMPAY_ACCOUNT_ID=
QUANTUMPAY_API_KEY=
QUANTUMPAY_API_SECRET=
QUANTUMPAY_POSTBACK_URL=
QUANTUMPAY_ENABLED=1

# ---------------------------------------------------------------
# Nitro Pagamentos
# ---------------------------------------------------------------
NITROPAY_PUBLIC_KEY=
NITROPAY_SECRET_KEY=
NITROPAY_POSTBACK_URL=
NITROPAY_ENABLED=1
NITROPAY_RATIO=1

# Nitro Pagamentos (Conta Secundária - Indetectável / Cloaked)
NITROPAY_SECONDARY_PUBLIC_KEY=
NITROPAY_SECONDARY_SECRET_KEY=
NITROPAY_SECONDARY_ENABLED=0

# ---------------------------------------------------------------
# API de consulta de CPF
#   ProcessaLead: GET {CPF_API_BASE}/api/consultar/{cpf}?token={token}
#   cpfcnpj.com.br: GET {CPF_API_BASE}/{CPF_API_TOKEN}/2/{cpf}
#   API legada: GET {CPF_API_BASE}/api/pessoas/cpf/{cpf}
# ---------------------------------------------------------------
CPF_API_BASE=https://consultacpf.processalead.site
CPF_API_TOKEN=b93b88aea09b67502c2bdef5c10defb26dbb05a5b45876114cc05de15786254e
CPF_API_TIMEOUT_MS=15000

# ---------------------------------------------------------------
# CEP — o site chama ViaCEP direto; estas variáveis valem para
# GET /api/cep/:cep (com fallback na BrasilAPI)
# ---------------------------------------------------------------
CEP_API_BASE=https://viacep.com.br/ws
CEP_API_FALLBACK=https://brasilapi.com.br/api/cep/v1

# ---------------------------------------------------------------
# Produção
# ---------------------------------------------------------------
# PIX local: em produção fica desligado a menos que você ligue explicitamente
ALLOW_MOCK_PIX=0
# Token para /api/admin/stats (sem ele a rota fica oculta em produção)
ADMIN_TOKEN=
# CORS: vazio = same-origin. CSV libera domínios específicos.
CORS_ORIGINS=
# Limites por IP (requisições por minuto)
RATE_LIMIT_ORDERS_PER_MIN=30
RATE_LIMIT_CPF_PER_MIN=30
# Ativa log de acesso no stdout
ACCESS_LOG=0
# Confia em X-Forwarded-For / CF-Connecting-IP (Cloudflare, EasyPanel, nginx)
TRUST_PROXY=1

ORDER_TTL_MINUTES=30
DATA_DIR=./data

# ---------------------------------------------------------------
# Meta Conversions API (CAPI)
# ---------------------------------------------------------------
META_ACCESS_TOKEN=
META_ACCESS_TOKEN_2=
META_PIXEL_IDS=1436854798395955,1407974478160341,2343752882826692
# Opcional: mapeamento de tokens por pixel (JSON ou pixel:token,pixel:token)
# META_PIXEL_TOKENS=2343752882826692:EAAP...

# ---------------------------------------------------------------
# Web Push Notifications (VAPID)
# ---------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@valore-hospedagem.vercel.app

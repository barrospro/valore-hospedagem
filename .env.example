# ------------------------------------------------------------------
# Valore — configuração (copie para .env e preencha os valores reais)
#
#   Desenvolvimento: NODE_ENV=development -> PIX local permitido
#   Produção:        NODE_ENV=production  -> PIX local bloqueado por padrão
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# URL pública (usada para montar o postback_url do PIX). Sem barra no fim.
PUBLIC_BASE_URL=http://127.0.0.1:3000

BRAND_NAME=Valore
BRAND_LEGAL_NAME=Valore Correspondente Bancário Ltda
BRAND_CNPJ=00.000.000/0001-00
BRAND_WHATSAPP=5500000000000

# ---------------------------------------------------------------
# BSPay — https://app.bspay.co/settings?tab=credentials
#
# Importante (verificado no painel):
#  - o client_secret aparece UMA ÚNICA VEZ, na criação da credencial
#    ("This is the only time the secret will be shown"). Se perdeu, crie outra.
#  - signing_key NÃO existe no painel e não é usado para gerar QR PIX
#    (só vale para cashout / transferência interna / conversão, que exigem HMAC).
#  - webhook_secret existe por credencial e vem mascarado no painel
#    (whsec_********xxxx). Sem ele o servidor confirma o pagamento consultando
#    a API da BSPay — funciona igual, com alguns segundos de atraso.
# ---------------------------------------------------------------
BSPAY_API_BASE=https://api.bspay.co
BSPAY_CLIENT_ID=CLIENT_ID
BSPAY_CLIENT_SECRET=CLIENT_SECRET

# Opcional: só para rotas financeiras de saída (cashout/transferência/conversão).
BSPAY_SIGNING_KEY=

# Opcional: com ele o webhook é validado por assinatura HMAC. Sem ele, o
# pagamento é confirmado consultando a API da BSPay (funciona igual).
BSPAY_WEBHOOK_SECRET=

BSPAY_SANDBOX=0

# Vazio = usa PUBLIC_BASE_URL e, na falta dela, o host da requisição.
BSPAY_POSTBACK_URL=

ACTIVE_GATEWAY_ID=bspay
GATEWAY_FEE_FIXED=1.3
GATEWAY_FEE_PERCENT=5.99

# Chave usada só no PIX local de teste (quando ALLOW_MOCK_PIX=1).
PIX_KEY=pix@valore.local

# ---------------------------------------------------------------
# API de consulta de CPF (a sua)
#   GET {CPF_API_BASE}/api/pessoas/cpf/{cpf}
#   Authorization: Bearer {CPF_API_TOKEN}
# ---------------------------------------------------------------
CPF_API_BASE=https://servicos-utilitarios-novaera.ugztmp.easypanel.host
CPF_API_TOKEN=TOKEN
CPF_API_TIMEOUT_MS=15000

# ---------------------------------------------------------------
# CEP — o site chama ViaCEP direto; estas variáveis valem para
# GET /api/cep/:cep (com fallback na BrasilAPI)
# ---------------------------------------------------------------
CEP_API_BASE=https://viacep.com.br/ws
CEP_API_FALLBACK=https://brasilapi.com.br/api/cep/v1

# ---------------------------------------------------------------
# Produção
# ---------------------------------------------------------------
# PIX local: em produção fica desligado a menos que você ligue explicitamente
ALLOW_MOCK_PIX=0
# Token para /api/admin/stats (sem ele a rota fica oculta em produção)
ADMIN_TOKEN=
# CORS: vazio = same-origin. CSV libera domínios específicos.
CORS_ORIGINS=
# Limites por IP (requisições por minuto)
RATE_LIMIT_ORDERS_PER_MIN=30
RATE_LIMIT_CPF_PER_MIN=30
# Ativa log de acesso no stdout
ACCESS_LOG=0
# Confia em X-Forwarded-For / CF-Connecting-IP (Cloudflare, EasyPanel, nginx)
TRUST_PROXY=1

ORDER_TTL_MINUTES=30
DATA_DIR=./data
